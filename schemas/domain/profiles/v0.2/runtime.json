    "read",
    "runtime_execute",
    "export_destructive"
  ],
  "tools": [
    "asset.status",
    "capabilities.get",
    "debug.command",
    "debug.session.get",
    "editor.session.start",
    "editor.session.stop",
    "export.presets.list",
    "file.get",
    "gdscript.diagnostics.get",
    "gdscript.impact.get",
    "gdscript.references.get",
    "gdscript.symbols.get",
    "health.get",
    "input.action.send",
    "input.key.send",
    "input.mouse.send",
    "input.sequence.send",
    "project.dependencies.get",
    "project.discover",
    "project.export",
    "project.export.cancel",
    "project.export.status",
    "project.files.list",
    "project.info.get",
    "project.run",
    "project.run.logs",
    "project.run.start",
    "project.run.status",
    "project.run.stop",
    "project.settings.get",
    "project.test",
    "project.validate",
    "resource.dependencies.get",
    "resource.tree.get",
    "runtime.properties.get",
    "runtime.recording.capture",
    "runtime.screenshot.capture",
    "runtime.signals.get",
    "runtime.tree.get",
    "runtime.ui.get",
    "scene.dependencies.get",
    "scene.tree.get",
    "script.check",
    "script.validate"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godot-mcp.invalid/schemas/domain/project-commands-v1.schema.json",
  "title": "Project command declaration (v1)",
  "description": "The godot_mcp_commands.json file at a Godot project's root: the commands the project declares for MCP clients to call through a connected editor. Each provider names a GDScript file whose class implements mcp_call(command, args).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "providers"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "providers": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "script",
          "commands"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "script": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1024,
            "pattern": "^res://[^\\\\]+\\.gd$"
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "title",
                "description",
                "input_schema",
                "mutates"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9_.-]*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "input_schema": {
                  "type": "object"
                },
                "mutates": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}

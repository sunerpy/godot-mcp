{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContractSchemaCatalog",
  "description": "Aggregate type used solely to generate the committed public contract schema.",
  "type": "object",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactContract"
    },
    "capabilities": {
      "$ref": "#/$defs/CapabilitiesReport"
    },
    "error": {
      "$ref": "#/$defs/OutcomeError"
    },
    "health": {
      "$ref": "#/$defs/HealthReport"
    },
    "operation_effect": {
      "$ref": "#/$defs/OperationEffect"
    },
    "policy": {
      "$ref": "#/$defs/PolicyDecision"
    },
    "project_identity": {
      "$ref": "#/$defs/ProjectIdentity"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "scheduler": {
      "$ref": "#/$defs/SchedulerState"
    },
    "static_result": {
      "$ref": "#/$defs/StaticResult"
    },
    "typed_value": {
      "$ref": "#/$defs/GodotValue"
    }
  },
  "additionalProperties": false,
  "required": [
    "project_identity",
    "provenance",
    "typed_value",
    "static_result",
    "operation_effect",
    "health",
    "capabilities",
    "scheduler",
    "policy",
    "artifact",
    "error"
  ],
  "$defs": {
    "Aabb": {
      "description": "Typed Godot axis-aligned bounding box.",
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/Vector3"
        },
        "size": {
          "$ref": "#/$defs/Vector3"
        }
      },
      "additionalProperties": false,
      "required": [
        "position",
        "size"
      ]
    },
    "ArtifactContract": {
      "description": "Complete public artifact contract, intentionally incapable of carrying a path.",
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "expires_at_unix_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "metadata": {
          "$ref": "#/$defs/ArtifactMetadata"
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactOwner"
            },
            {
              "type": "null"
            }
          ]
        },
        "project": {
          "$ref": "#/$defs/ProjectIdentity"
        },
        "ranges": {
          "$ref": "#/$defs/RangeSemantics"
        },
        "resource_uri": {
          "$ref": "#/$defs/ArtifactResourceUri"
        },
        "schema_version": {
          "$ref": "#/$defs/ContractVersion"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_id",
        "resource_uri",
        "project",
        "metadata",
        "expires_at_unix_ms",
        "ranges"
      ]
    },
    "ArtifactId": {
      "description": "Validated opaque `artifact_` identifier.",
      "type": "string"
    },
    "ArtifactKind": {
      "description": "Public artifact media family.",
      "type": "string",
      "enum": [
        "screenshot",
        "recording",
        "diagnostic_bundle",
        "report",
        "export"
      ]
    },
    "ArtifactMetadata": {
      "description": "Public artifact metadata. No storage locator is representable.",
      "type": "object",
      "properties": {
        "byte_length": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "created_at_unix_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "media_type": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "media_type",
        "byte_length",
        "sha256",
        "created_at_unix_ms"
      ]
    },
    "ArtifactOwner": {
      "description": "Principal/session restrictions attached to an artifact.",
      "type": "object",
      "properties": {
        "principal": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrincipalId"
            },
            {
              "type": "null"
            }
          ]
        },
        "session": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ArtifactResourceUri": {
      "description": "Opaque public URI for a generated artifact.",
      "type": "string"
    },
    "Basis": {
      "description": "Typed Godot basis.",
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/Vector3"
        },
        "y": {
          "$ref": "#/$defs/Vector3"
        },
        "z": {
          "$ref": "#/$defs/Vector3"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "CapabilitiesReport": {
      "description": "Public capability result with source and confidence evidence.",
      "type": "object",
      "properties": {
        "available": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "uniqueItems": true
        },
        "manifest": {
          "$ref": "#/$defs/ProfileManifest"
        },
        "project": {
          "$ref": "#/$defs/ProjectIdentity"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "schema_version": {
          "$ref": "#/$defs/ContractVersion"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project",
        "manifest",
        "available",
        "provenance"
      ]
    },
    "Capability": {
      "description": "Stable public capability identifiers.",
      "type": "string",
      "enum": [
        "read",
        "project_write",
        "editor_mutate",
        "runtime_execute",
        "export_destructive"
      ]
    },
    "CapabilityProfile": {
      "description": "Capability profiles exposed by the public contract. Selection is explicit\nand independent of how an outcome is requested.\n\n`Full` is the union of `Core`, `Editor` and `Runtime`, excluding the\nseparately gated (and first-release-absent) unsafe execution capability.",
      "oneOf": [
        {
          "description": "Read-only discovery and analysis.",
          "type": "string",
          "const": "core"
        },
        {
          "description": "Adds the project-write and editor-mutation methods this build implements.",
          "type": "string",
          "const": "editor"
        },
        {
          "description": "Adds the runtime-execution and export methods this build implements.",
          "type": "string",
          "const": "runtime"
        },
        {
          "description": "Union of the above, excluding unsafe execution.",
          "type": "string",
          "const": "full"
        }
      ]
    },
    "Color": {
      "description": "Typed Godot color with linear component values.",
      "type": "object",
      "properties": {
        "alpha": {
          "type": "number",
          "format": "double"
        },
        "blue": {
          "type": "number",
          "format": "double"
        },
        "green": {
          "type": "number",
          "format": "double"
        },
        "red": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "red",
        "green",
        "blue",
        "alpha"
      ]
    },
    "ComponentHealth": {
      "description": "One bounded health component result.",
      "type": "object",
      "properties": {
        "component": {
          "$ref": "#/$defs/ComponentName"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/HealthStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "component",
        "status"
      ]
    },
    "ComponentName": {
      "description": "Named public health component.",
      "type": "string",
      "enum": [
        "project",
        "index",
        "godot",
        "editor",
        "runtime",
        "scheduler",
        "authorization"
      ]
    },
    "Confidence": {
      "description": "Confidence of a static answer. Partial scanners and dynamic GDScript are\nnever represented as certain: every static answer carries provenance and one\nof these confidence levels.",
      "oneOf": [
        {
          "description": "Statically proven.",
          "type": "string",
          "const": "exact"
        },
        {
          "description": "Inferred from heuristics; the single best candidate is not guaranteed.",
          "type": "string",
          "const": "inferred"
        },
        {
          "description": "Could not be resolved.",
          "type": "string",
          "const": "unresolved"
        }
      ]
    },
    "ContractVersion": {
      "description": "Exact version marker carried by every top-level public contract.",
      "oneOf": [
        {
          "description": "Initial frozen contract.",
          "type": "string",
          "const": "0.1.0"
        },
        {
          "description": "Implementation-backed discovery: a profile lists only implemented methods.",
          "type": "string",
          "const": "0.2.0"
        }
      ]
    },
    "EffectDisposition": {
      "description": "Stable disposition of an attempted effect.",
      "type": "string",
      "enum": [
        "no_change",
        "committed",
        "compensated",
        "quarantined",
        "cancelled"
      ]
    },
    "ErrorKind": {
      "description": "Stable outcome-error taxonomy shared by every public operation.",
      "type": "string",
      "enum": [
        "invalid_input",
        "not_found",
        "conflict",
        "unsupported",
        "permission_denied",
        "timeout",
        "cancelled",
        "unavailable",
        "uncertain",
        "internal"
      ]
    },
    "GodotValue": {
      "description": "Complete first-release typed Godot value algebra.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "null"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "float"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "string_name"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "node_path"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "vector2"
            },
            "value": {
              "$ref": "#/$defs/Vector2"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "vector2i"
            },
            "value": {
              "$ref": "#/$defs/Vector2i"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rect2"
            },
            "value": {
              "$ref": "#/$defs/Rect2"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rect2i"
            },
            "value": {
              "$ref": "#/$defs/Rect2i"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "vector3"
            },
            "value": {
              "$ref": "#/$defs/Vector3"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "vector3i"
            },
            "value": {
              "$ref": "#/$defs/Vector3i"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "transform2_d"
            },
            "value": {
              "$ref": "#/$defs/Transform2D"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "vector4"
            },
            "value": {
              "$ref": "#/$defs/Vector4"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "vector4i"
            },
            "value": {
              "$ref": "#/$defs/Vector4i"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "plane"
            },
            "value": {
              "$ref": "#/$defs/Plane"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "quaternion"
            },
            "value": {
              "$ref": "#/$defs/Quaternion"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "aabb"
            },
            "value": {
              "$ref": "#/$defs/Aabb"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "basis"
            },
            "value": {
              "$ref": "#/$defs/Basis"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "transform3_d"
            },
            "value": {
              "$ref": "#/$defs/Transform3D"
            }
          },
          "required": [

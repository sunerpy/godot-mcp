    "HealthReport": {
      "description": "Public health result.",
      "type": "object",
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentHealth"
          }
        },
        "observed_at_unix_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "project": {
          "$ref": "#/$defs/ProjectIdentity"
        },
        "schema_version": {
          "$ref": "#/$defs/ContractVersion"
        },
        "status": {
          "$ref": "#/$defs/HealthStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project",
        "status",
        "components",
        "observed_at_unix_ms"
      ]
    },
    "HealthStatus": {
      "description": "Overall or component health state.",
      "type": "string",
      "enum": [
        "ready",
        "degraded",
        "unavailable"
      ]
    },
    "Matrix4": {
      "description": "Four-by-four matrix used by a Godot projection.",
      "type": "object",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "maxItems": 4,
            "minItems": 4
          },
          "maxItems": 4,
          "minItems": 4
        }
      },
      "additionalProperties": false,
      "required": [
        "rows"
      ]
    },
    "ObjectReference": {
      "description": "An opaque live-object reference.",
      "type": "object",
      "properties": {
        "class_name": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/OpaqueObjectId"
        }
      },
      "additionalProperties": false,

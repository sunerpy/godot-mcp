            "plugin_version": { "type": "string" },
            "godot_version": { "type": "string" },
            "session_id": { "type": "null" }
          }
        },
        "project": { "type": "object" },
        "auth": { "type": "object" },
        "error": { "type": "null" },
        "progress": { "type": "null" },
        "payload": { "type": "null" }
      }

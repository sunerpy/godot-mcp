{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godot-mcp.invalid/schemas/gates/batch-bundle.schema.json",
  "title": "B3/B4 dual-review input bundle",
  "description": "Canonical review-input bundle generated deterministically before a B3/B4 batch begins. Owned and implemented by Todo 6's batch-review-bundle binary. Todo 1 ships this as a restrictive, syntactically valid stub schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch",
    "plan_sha256",
    "target_plan_slice",
    "base_source_identity",
    "dependency_matrix_rows"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "batch": { "type": "string", "enum": ["b3", "b4"] },
    "plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "target_plan_slice": {
      "type": "string",
      "minLength": 1,
      "description": "Canonicalized substring of the plan's reviewed Todo range."
    },
    "base_source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": { "type": "string", "minLength": 1 },
        "tree": { "type": "string", "minLength": 1 }
      }
    },
    "dependency_matrix_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godot-mcp.invalid/schemas/gates/batch-approval-manifest.schema.json",
  "title": "B3/B4 batch approval manifest",
  "description": "Emitted by finalize-batch-review only when both independent receipts APPROVE with zero open Blocker/Major. Owned and implemented by Todo 6. Todo 1 ships this as a restrictive, syntactically valid stub schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch",
    "plan_sha256",
    "bundle_sha256",
    "receipts",
    "approved"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "batch": { "type": "string", "enum": ["b3", "b4"] },
    "plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bundle_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "receipts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_identity", "receipt_sha256"],
        "properties": {
          "reviewer_identity": { "type": "string", "minLength": 1 },
          "receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "approved": { "type": "boolean", "const": true }
  }
}

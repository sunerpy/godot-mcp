; Committed Todo 15 fixture project: a project with gdUnit4 already installed.
;
; The gdUnit4 addon here is a committed *marker set*, not a vendored copy of
; gdUnit4: exactly the files a real installation has that detection keys on.

config_version=5

[application]

config/name="Todo 15 gdUnit4 Fixture"
config/features=PackedStringArray("4.4")

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")
